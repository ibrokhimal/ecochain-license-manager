FROM debian:bookworm-slim AS tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    swtpm tpm2-tools libtss2-tcti-swtpm0 python3 python3-yaml \
    && rm -rf /var/lib/apt/lists/*

FROM tools AS test
COPY --from=ecochain-license:local /usr/local/bin/licensectl /usr/local/bin/licensectl
COPY --from=ecochain-license:local /usr/local/bin/license-tpm /usr/local/bin/license-tpm
COPY scripts/tpm-simulator-inner.sh /usr/local/bin/tpm-simulator-test
WORKDIR /work
CMD ["bash", "/usr/local/bin/tpm-simulator-test"]
